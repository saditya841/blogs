# Copy this file to ".dev.vars" for `npx wrangler dev`.
# NEVER commit .dev.vars — it is git-ignored.
# In production use: npx wrangler secret put NAME

# Required for /admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional AI providers (any one is enough; Workers AI needs no key)
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=

# Optional media
PEXELS_API_KEY=
YOUTUBE_API_KEY=

# Optional: override any wrangler.toml var locally
# ADSENSE_PUB=pub-0000000000000000
# ADSENSE_SLOT=0000000000
# ADSENSE_SLOT_BOTTOM=0000000000
# SCORE_MAX=94
# ENABLE_AI_EDITOR=true
# EDITOR_MAX_ROUNDS=2
# CARD_INDEX=
# Multi-AI debate
# DEBATE_ENABLED=true
# DEBATE_ROUNDS=1
# DEBATE_ROLES=3
# DEBATE_TIMEOUT_MS=45000
# DEBATE_REUSE_SECONDS=7200
# DEBATE_PROVIDER_ORDER=cohere,groq,gemini
# MIN_AGREE_SOURCES=2
# Duplicate + style guard
# DUPLICATE_CHECK=true
# DUP_MAX_SIMILARITY=0.82
# DUP_CHECK_LIMIT=400
# STYLE_MIN_SCORE=60
