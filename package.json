{
  "name": "virall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Virall — Cloudflare-only AI news blog (Workers + D1 + Workers AI + AdSense)",
  "scripts": {
    "test": "node --test --no-warnings test",
    "check": "node scripts/check.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute virall-db --remote --file=schema.sql",
    "db:migrate": "wrangler d1 execute virall-db --remote --file=migration_v3.sql"
  }
}
